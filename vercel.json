{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/portal",
      "destination": "/ingresar",
      "permanent": false
    },
    {
      "source": "/portal/:path*",
      "destination": "/ingresar",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/ingresar",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "/ingresar",
      "permanent": false
    },
    {
      "source": "/early",
      "destination": "/es#lista",
      "permanent": false
    },
    {
      "source": "/waitlist",
      "destination": "/es#lista",
      "permanent": false
    },
    {
      "source": "/welcome",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/welcome/:path*",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/plan",
      "destination": "/#price",
      "permanent": false
    },
    {
      "source": "/family-portal",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/demo?lang=es",
      "permanent": false
    },
    {
      "source": "/family-portal",
      "destination": "/demo",
      "permanent": false
    },
    {
      "source": "/family-portal.html",
      "destination": "/demo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://web-production-0134d.up.railway.app/api/:path*"
    },
    {
      "source": "/app",
      "destination": "https://web-production-0134d.up.railway.app/app"
    },
    {
      "source": "/demo",
      "destination": "https://web-production-0134d.up.railway.app/demo"
    },
    {
      "source": "/manage",
      "destination": "https://web-production-0134d.up.railway.app/manage"
    },
    {
      "source": "/admin",
      "destination": "https://web-production-0134d.up.railway.app/admin"
    },
    {
      "source": "/r/:path*",
      "destination": "https://web-production-0134d.up.railway.app/r/:path*"
    },
    {
      "source": "/stripe/webhook",
      "destination": "https://web-production-0134d.up.railway.app/stripe/webhook"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: https://www.callelderly.com https://accounts.google.com https://*.googleusercontent.com; font-src 'self'; media-src 'self' https://www.callelderly.com; connect-src 'self' https://www.callelderly.com https://accounts.google.com; frame-src 'self' https://accounts.google.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(es|ingresar|privacy|terms|blog)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: https://www.callelderly.com https://accounts.google.com https://*.googleusercontent.com; font-src 'self'; media-src 'self' https://www.callelderly.com; connect-src 'self' https://www.callelderly.com https://accounts.google.com; frame-src 'self' https://accounts.google.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: https://www.callelderly.com https://accounts.google.com https://*.googleusercontent.com; font-src 'self'; media-src 'self' https://www.callelderly.com; connect-src 'self' https://www.callelderly.com https://accounts.google.com; frame-src 'self' https://accounts.google.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(app|demo|manage|admin|plan)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/fonts.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
