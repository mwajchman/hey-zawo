<meta charset="utf-8">
<title>Elderly | Care for aging parents through prevention, education, and connection</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Elderly calls your aging parents every day to keep them company, watch over their wellbeing, and help protect them from scams. They get a brighter day. You get peace of mind.">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">
<script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('theme')||'light')}catch(e){document.documentElement.setAttribute('data-theme','light')}</script>
<style>
  :root{
    --bg:#FBF6EC; --surface:#FFFDF7; --raise:#FFFFFF;
    --ink:#123330; --ink-soft:#51655F; --line:#E7DECB;
    --pine:#0B5F5D; --pine-2:#0E7C7B; --amber:#A9741E; --amber-2:#E6AE55;
    --sage:#2E6E52; --clay:#B4623F; --slate:#0E7C7B; --wa:#25D366;
    --font-serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
    --font-sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    --maxw:1140px;
  }
  @media (prefers-color-scheme:dark){
    :root{ --bg:#0F1917; --surface:#15211E; --raise:#1B2825; --ink:#EEE7D8; --ink-soft:#9FB0AA; --line:#28352F; --pine:#0E7C7B; --pine-2:#3FB0AC; --amber:#E6AE55; --amber-2:#F0C275; --sage:#5FA080; --clay:#D08A63; --slate:#3FB0AC; }
  }
  :root[data-theme="light"]{ --bg:#FBF6EC; --surface:#FFFDF7; --raise:#FFFFFF; --ink:#123330; --ink-soft:#51655F; --line:#E7DECB; --pine:#0B5F5D; --pine-2:#0E7C7B; --amber:#A9741E; --amber-2:#E6AE55; --sage:#2E6E52; --clay:#B4623F; --slate:#0E7C7B; }
  :root[data-theme="dark"]{ --bg:#0F1917; --surface:#15211E; --raise:#1B2825; --ink:#EEE7D8; --ink-soft:#9FB0AA; --line:#28352F; --pine:#0E7C7B; --pine-2:#3FB0AC; --amber:#E6AE55; --amber-2:#F0C275; --sage:#5FA080; --clay:#D08A63; --slate:#3FB0AC; }

  *{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-sans);font-size:17px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
  h1,h2,h3{font-family:var(--font-serif);font-weight:600;line-height:1.12;text-wrap:balance;margin:0;letter-spacing:-.01em;}
  p{margin:0;} a{color:inherit;} img{display:block;max-width:100%;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
  .eyebrow{font-family:var(--font-sans);text-transform:uppercase;letter-spacing:.18em;font-size:11.5px;font-weight:700;color:var(--pine-2);}
  .lead{color:var(--ink-soft);font-size:1.2rem;line-height:1.55;max-width:56ch;}

  .btn{display:inline-flex;align-items:center;gap:9px;font-family:var(--font-sans);font-weight:600;font-size:1rem;padding:14px 24px;border-radius:10px;text-decoration:none;border:1.5px solid transparent;cursor:pointer;transition:transform .18s ease,background .2s ease,box-shadow .2s ease;}
  .btn-primary{background:var(--pine);color:#FBF6EC;box-shadow:0 8px 22px -10px rgba(11,95,93,.7);}
  .btn-primary:hover{transform:translateY(-2px);background:var(--pine-2);box-shadow:0 14px 28px -10px rgba(11,95,93,.8);}
  .btn-ghost{background:transparent;border-color:var(--line);color:var(--ink);}
  .btn-ghost:hover{border-color:var(--ink-soft);transform:translateY(-2px);}
  a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--amber-2);outline-offset:2px;border-radius:8px;}

  /* Scroll reveal + effects */
  .reveal{transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1);}
  html.js-anim .reveal{opacity:0;transform:translateY(26px);}
  html.js-anim .reveal.in{opacity:1;transform:none;}
  .reveal.d1{transition-delay:.08s;} .reveal.d2{transition-delay:.16s;} .reveal.d3{transition-delay:.24s;}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto;}.reveal{opacity:1;transform:none;transition:none;}*{animation:none!important;}}

  header.nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);transition:background .25s ease,box-shadow .25s ease,border-color .25s ease;}
  header.nav.scrolled{background:color-mix(in srgb,var(--bg) 97%,transparent);box-shadow:0 6px 22px -16px rgba(10,30,25,.5);}
  .nav-in{display:flex;align-items:center;justify-content:space-between;height:72px;}
  .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);}
  .brand .bmark{width:31px;height:31px;display:block;flex:none;}
  .brand .bname{font-family:"Plus Jakarta Sans",var(--font-sans);font-weight:700;font-size:1.4rem;letter-spacing:-.03em;color:inherit;}
  @keyframes glow{0%,100%{box-shadow:0 0 0 0 rgba(230,174,85,.5);}50%{box-shadow:0 0 0 6px rgba(230,174,85,0);}}
  .nav-links{display:flex;gap:30px;}
  .nav-links a{text-decoration:none;color:var(--ink-soft);font-weight:500;font-size:.96rem;transition:color .2s;}
  .nav-links a:hover{color:var(--ink);}
  .nav-cta{display:flex;align-items:center;gap:14px;}
  .theme-toggle{background:transparent;border:1px solid var(--line);color:var(--ink-soft);width:40px;height:40px;border-radius:10px;cursor:pointer;display:grid;place-items:center;transition:color .2s,border-color .2s;}
  .theme-toggle:hover{color:var(--ink);border-color:var(--ink-soft);}
  @media(max-width:880px){.nav-links{display:none;}}

  .hero{position:relative;overflow:hidden;padding:0;}
  .hero::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
    background:radial-gradient(52% 44% at 82% 14%,rgba(14,124,123,.14),transparent 70%),radial-gradient(40% 40% at 12% 8%,rgba(230,174,85,.12),transparent 70%);}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.02fr .98fr;gap:52px;align-items:center;padding:60px 24px 78px;}
  .hero h1{font-size:clamp(2.6rem,5.2vw,4.3rem);}
  .hero h1 .it{font-style:italic;color:var(--pine-2);}
  .hero h1 .sub{display:block;margin-top:.4em;font-size:.44em;font-weight:500;line-height:1.3;color:var(--ink-soft);}
  .hero .lead{margin-top:22px;}
  .hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px;}
  .trust-row{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:24px;color:var(--ink-soft);font-size:.9rem;font-weight:500;}
  .trust-row span{display:inline-flex;align-items:center;gap:7px;}
  .trust-row svg{color:var(--pine-2);flex:none;}
  .hero-photo{position:relative;}
  .hero-photo img{width:100%;height:560px;object-fit:cover;border-radius:16px;}
  .hero-badge{position:absolute;left:-18px;bottom:26px;background:var(--raise);border:1px solid var(--line);border-radius:14px;padding:14px 16px;box-shadow:0 22px 44px -20px rgba(10,30,25,.5);display:flex;gap:12px;align-items:center;max-width:250px;animation:floaty 4.5s ease-in-out infinite;}
  @keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
  .hero-badge .ic{flex:none;width:40px;height:40px;border-radius:11px;background:var(--pine);color:#FBF6EC;display:grid;place-items:center;}
  .hero-badge b{font-family:var(--font-serif);font-size:1rem;} .hero-badge span{font-size:12px;color:var(--ink-soft);}
  @media(max-width:880px){.hero-grid{grid-template-columns:1fr;gap:22px;padding:22px 24px 40px;}.hero .lead{max-width:none;}.hero-photo{order:2;}.hero-photo img{height:300px;}.hero-badge{left:0;}}
  @media(max-width:560px){.hero h1{font-size:1.72rem;line-height:1.2;}.hero-photo img{height:250px;}.nav-cta .btn-primary{display:none;}}

  .stats{background:var(--pine);color:#E9F0EA;padding:0;}
  .stats .wrap{padding:62px 24px;}
  .stats .sh{max-width:52ch;margin-bottom:40px;}
  .stats .sh .eyebrow{color:var(--amber-2);}
  .stats .sh h2{color:#F5F0E2;font-size:clamp(1.7rem,3.2vw,2.4rem);margin-top:10px;}
  .stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;}
  .stat{border-top:2px solid rgba(255,255,255,.2);padding-top:18px;}
  .stat .big{font-family:var(--font-serif);font-size:2.9rem;line-height:1;color:#fff;letter-spacing:-.02em;font-variant-numeric:tabular-nums;}
  .stat .accent{color:var(--amber-2);}
  .stat .txt{margin-top:12px;font-size:1.02rem;line-height:1.5;color:#D7DED2;}
  .stat .src{margin-top:14px;font-family:var(--font-sans);font-size:.78rem;letter-spacing:.03em;color:#9DB0A2;text-transform:uppercase;}
  @media(max-width:820px){.stat-row{grid-template-columns:1fr;gap:30px;}}

  section{padding:88px 0;}
  .sec-head{max-width:52ch;margin:0 auto 50px;text-align:center;}
  .sec-head h2{font-size:clamp(1.9rem,3.6vw,2.7rem);margin:12px 0 14px;}
  .sec-head p{color:var(--ink-soft);font-size:1.14rem;}

  .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .pillar{position:relative;overflow:hidden;padding:24px 22px 22px;border-radius:16px;color:#EAF3EC;background:#1D4A3E;transition:transform .25s ease,box-shadow .25s ease;}
  .pillar.mind{background:#8A4B2A;}
  .pillar.money{background:#1A5563;}
  .pillar:hover{transform:translateY(-6px);box-shadow:0 26px 50px -28px rgba(10,30,25,.55);}
  .pillar .ic{position:absolute;top:-8px;right:-8px;margin:0;color:rgba(255,255,255,.10);}
  .pillar .ic svg{width:120px;height:120px;}
  .pillar .tag{display:inline-block;font-family:var(--font-sans);text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:700;color:#fff;background:rgba(255,255,255,.15);padding:4px 10px;border-radius:999px;margin-bottom:12px;}
  .pillar h3{font-size:1.4rem;margin:0 0 14px;color:#fff;}
  .pillar ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:9px;}
  .pillar li{display:flex;gap:10px;align-items:flex-start;color:rgba(255,255,255,.9);font-size:.96rem;line-height:1.45;}
  .pillar li svg{flex:none;margin-top:4px;color:rgba(255,255,255,.85);}
  .pillar .ic{transition:transform .45s ease,color .45s ease;}
  .pillar:hover .ic{transform:scale(1.1) rotate(-6deg);color:rgba(255,255,255,.16);}
  .pillar:hover{filter:brightness(1.05);}
  @media(max-width:820px){.pillars{grid-template-columns:1fr;gap:14px;}}
  .disclaimer{text-align:center;color:var(--ink-soft);font-size:.9rem;max-width:66ch;margin:34px auto 0;}

  .week{border-top:1px solid var(--line);background:var(--surface);}
  .week-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:12px;}
  .day{background:var(--raise);border:1px solid var(--line);border-radius:14px;padding:16px 14px;display:flex;flex-direction:column;gap:9px;min-height:158px;transition:transform .22s ease,box-shadow .22s ease;}
  .day:hover{transform:translateY(-5px);box-shadow:0 20px 40px -26px rgba(10,30,25,.55);}
  .day .dname{font-family:var(--font-sans);font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--ink-soft);font-weight:700;}
  .chip{align-self:flex-start;font-family:var(--font-sans);font-size:11.5px;font-weight:700;padding:4px 11px;border-radius:999px;color:var(--tc);background:color-mix(in srgb,var(--tc) 16%,transparent);}
  .chip.conn{--tc:var(--slate);} .chip.edu{--tc:var(--clay);} .chip.prev{--tc:var(--sage);}
  .day .ex{font-size:.88rem;color:var(--ink-soft);line-height:1.42;}
  @media(max-width:900px){.week-grid{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:560px){.week-grid{grid-template-columns:1fr 1fr;}}

  .demo{background:var(--pine);color:#EAF1EB;padding:0;}
  .demo .wrap{padding:76px 24px;}
  .demo-grid{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center;}
  .demo .eyebrow{color:var(--amber-2);}
  .demo h2{color:#F5F0E2;font-size:clamp(1.9rem,3.6vw,2.6rem);margin:12px 0 14px;}
  .demo .lead{color:#D7DED2;}
  .demo .badge{display:inline-flex;align-items:center;gap:8px;background:rgba(230,174,85,.16);color:var(--amber-2);font-weight:700;font-size:.8rem;padding:6px 13px;border-radius:999px;margin-bottom:6px;}
  .demo .badge .pulse{width:8px;height:8px;border-radius:999px;background:var(--amber-2);animation:pdot 1.6s ease-in-out infinite;}
  @keyframes pdot{0%,100%{opacity:.4;transform:scale(.8);}50%{opacity:1;transform:scale(1.2);}}
  .demo-pts{list-style:none;padding:0;margin:22px 0 0;display:flex;flex-direction:column;gap:10px;color:#CBD5CB;}
  .demo-pts li{display:flex;gap:10px;align-items:flex-start;} .demo-pts li svg{color:var(--amber-2);flex:none;margin-top:3px;}
  .demo-card{background:var(--raise);color:var(--ink);border-radius:18px;padding:28px;display:flex;flex-direction:column;gap:14px;box-shadow:0 26px 50px -24px rgba(0,0,0,.5);}
  .demo-card label{display:flex;flex-direction:column;gap:6px;font-size:.82rem;font-weight:700;color:var(--ink);}
  .demo-card input,.demo-card select{font-family:inherit;font-size:1rem;padding:12px 13px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);transition:border-color .2s;}
  .demo-card input:focus,.demo-card select:focus{border-color:var(--pine-2);}
  .demo-card .fine{font-size:.78rem;color:var(--ink-soft);text-align:center;margin:2px 0 0;}
  ._honey{position:absolute;left:-9999px;}
  .demo-done{text-align:center;padding:18px 6px;}
  .demo-done .okk{width:58px;height:58px;border-radius:999px;background:var(--pine);color:#fff;display:grid;place-items:center;margin:0 auto 14px;animation:pop .5s cubic-bezier(.2,1.3,.4,1);}
  @keyframes pop{0%{transform:scale(0);}100%{transform:scale(1);}}
  .demo-done h3{font-size:1.5rem;margin-bottom:8px;color:var(--ink);}
  .demo-done p{color:var(--ink-soft);}
  @media(max-width:820px){.demo-grid{grid-template-columns:1fr;gap:30px;}}

  .split{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .split .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
  .split img{width:100%;height:460px;object-fit:cover;border-radius:16px;}
  .split .eyebrow{color:var(--clay);}
  .split h2{font-size:clamp(1.8rem,3.4vw,2.5rem);margin:12px 0 16px;}
  .split p{color:var(--ink-soft);font-size:1.1rem;}
  .split .quote{margin-top:22px;padding-left:18px;border-left:3px solid var(--amber-2);font-family:var(--font-serif);font-style:italic;font-size:1.25rem;color:var(--ink);}
  @media(max-width:820px){.split .wrap{grid-template-columns:1fr;gap:28px;}.split img{height:300px;order:-1;}}

  .steps{display:grid;grid-template-columns:repeat(2,1fr);gap:28px 34px;}
  .step .n{font-family:var(--font-serif);font-size:1.4rem;color:var(--pine-2);position:relative;padding-bottom:10px;margin-bottom:12px;}
  .step .n::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:2px;background:var(--line);transform-origin:left;transition:transform .6s ease;}
  html.js-anim .step:not(.in) .n::after{transform:scaleX(0);}
  .step h3{font-size:1.3rem;margin-bottom:8px;} .step p{color:var(--ink-soft);}
  @media(max-width:760px){.steps{grid-template-columns:1fr;gap:22px;}}

  .peace{position:relative;color:#fff;overflow:hidden;padding:0;}
  .peace img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
  .peace .veil{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(9,28,24,.92),rgba(9,28,24,.5));}
  .peace .wrap{position:relative;z-index:2;padding:98px 24px;max-width:640px;}
  .peace h2{font-size:clamp(2rem,4vw,3rem);color:#fff;}
  .peace p{font-size:1.2rem;margin-top:16px;color:#E7EADD;}

  .testi .wrap{display:grid;grid-template-columns:auto 1fr;gap:32px;align-items:center;max-width:900px;}
  .testi img{width:150px;height:150px;border-radius:16px;object-fit:cover;}
  .testi blockquote{font-family:var(--font-serif);font-size:clamp(1.3rem,2.6vw,1.8rem);line-height:1.4;margin:0;color:var(--ink);}
  .testi .who{margin-top:16px;font-family:var(--font-sans);color:var(--ink-soft);font-size:.96rem;}
  @media(max-width:640px){.testi .wrap{grid-template-columns:1fr;}.testi img{width:110px;height:110px;}}

  .price-grid{display:grid;grid-template-columns:1fr 1.12fr;gap:24px;max-width:840px;margin:0 auto;align-items:start;}
  .plan .note{margin-top:8px;padding-top:16px;border-top:1px solid var(--line);color:var(--ink-soft);font-size:.92rem;}
  .plan{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:34px;display:flex;flex-direction:column;gap:8px;transition:transform .25s ease,box-shadow .25s ease;}
  .plan:hover{transform:translateY(-5px);box-shadow:0 28px 54px -32px rgba(10,30,25,.5);}
  .plan.feat{border-color:var(--pine);border-width:2px;position:relative;}
  .plan.feat .tag{position:absolute;top:-13px;left:34px;background:var(--pine);color:#FBF6EC;font-family:var(--font-sans);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 13px;border-radius:999px;}
  .plan .name{font-family:var(--font-serif);font-size:1.5rem;}
  .plan .price{font-family:var(--font-serif);font-size:2.9rem;letter-spacing:-.02em;margin:4px 0 0;}
  .plan .price small{font-family:var(--font-sans);font-size:1rem;color:var(--ink-soft);}
  .plan .sub{color:var(--ink-soft);}
  .plan .anchor{color:var(--amber);font-weight:600;font-size:.92rem;margin-top:2px;}
  .plan ul{list-style:none;padding:0;margin:18px 0 24px;display:flex;flex-direction:column;gap:11px;}
  .plan li{display:flex;gap:10px;align-items:flex-start;}
  .plan li svg{flex:none;margin-top:4px;color:var(--pine-2);}
  .plan .btn{margin-top:auto;justify-content:center;}
  .keep{text-align:center;color:var(--ink-soft);margin-top:22px;}
  @media(max-width:760px){.price-grid{grid-template-columns:1fr;}}

  .faq{max-width:760px;margin:0 auto;}
  details{border-bottom:1px solid var(--line);}
  summary{cursor:pointer;list-style:none;padding:18px 4px;font-family:var(--font-serif);font-size:1.18rem;font-weight:600;display:flex;justify-content:space-between;gap:16px;align-items:center;}
  summary::-webkit-details-marker{display:none;}
  summary .pm{color:var(--pine-2);font-size:1.5rem;line-height:1;transition:transform .2s ease;}
  details[open] summary .pm{transform:rotate(45deg);}
  details p{color:var(--ink-soft);padding:0 4px 18px;}

  footer{background:#0E211D;color:#AEBBB4;padding:52px 0 40px;}
  footer .wrap{display:flex;flex-wrap:wrap;gap:28px;justify-content:space-between;}
  footer .brand{color:#FBF6EC;}
  footer a{color:#AEBBB4;text-decoration:none;} footer a:hover{color:#fff;}
  .fcol{display:flex;flex-direction:column;gap:9px;font-size:.94rem;}
  .fcol b{color:#FBF6EC;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:3px;font-family:var(--font-sans);}
  .sources{width:100%;border-top:1px solid rgba(255,255,255,.13);margin-top:28px;padding-top:18px;font-size:.8rem;color:#8C978F;line-height:1.6;}

  /* Pillar strip */
  .pstrip{background:var(--surface);border-bottom:1px solid var(--line);}
  .pstrip .wrap{padding:30px 24px;}
  .pstrip .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .pcard{border-radius:16px;padding:24px;color:#fff;display:flex;flex-direction:column;gap:6px;position:relative;overflow:hidden;transition:transform .22s ease,box-shadow .22s ease;}
  .pcard:hover{transform:translateY(-5px);box-shadow:0 24px 46px -26px rgba(10,30,25,.55);}
  .pcard.b{background:linear-gradient(150deg,#3E8F66,#256B4B);} .pcard.m{background:linear-gradient(150deg,#C97A56,#A9563A);} .pcard.n{background:linear-gradient(150deg,#1AA6A0,#0B6360);}
  .pcard .k{font-family:var(--font-sans);text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:800;opacity:.92;}
  .pcard h3{font-size:1.4rem;color:#fff;}
  .pcard p{font-size:.95rem;opacity:.96;line-height:1.42;}
  .pcard .bg{position:absolute;right:-14px;bottom:-16px;opacity:.16;}
  @media(max-width:820px){.pstrip .grid{grid-template-columns:1fr;}}

  /* Comparison */
  .compare .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px;-webkit-overflow-scrolling:touch;}
  .ctab{border-collapse:collapse;width:100%;min-width:720px;font-family:var(--font-sans);}
  .ctab th,.ctab td{padding:14px 12px;text-align:center;border-bottom:1px solid var(--line);font-size:.92rem;}
  .ctab tbody tr:last-child td,.ctab tbody tr:last-child th{border-bottom:none;}
  .ctab thead th{background:var(--surface);font-weight:700;color:var(--ink);line-height:1.2;}
  .ctab thead th small{color:var(--ink-soft);font-weight:500;font-size:.75rem;}
  .ctab thead th.hzcol{color:var(--pine-2);}
  .ctab tbody th{text-align:left;font-weight:600;color:var(--ink);background:var(--surface);min-width:200px;}
  .ctab td.us{background:color-mix(in srgb,var(--pine) 12%,transparent);}
  .ctab .hz{color:var(--pine-2);font-weight:800;font-size:1.05rem;}
  .ctab .yes{color:var(--sage);font-weight:800;font-size:1.05rem;} .ctab .no{color:#B94A3E;font-weight:700;} .ctab .part{color:var(--amber);font-weight:800;}
  @media(max-width:600px){.ctab th,.ctab td{padding:11px 9px;font-size:.85rem;}.ctab tbody th{min-width:150px;}}

  /* Blog teaser */
  .blogt .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .bcard{background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:var(--ink);display:flex;flex-direction:column;transition:transform .22s ease,box-shadow .22s ease;}
  .bcard:hover{transform:translateY(-6px);box-shadow:0 26px 52px -30px rgba(10,30,25,.5);}
  .bcard .top{height:6px;} .bcard.c1 .top{background:var(--clay);} .bcard.c2 .top{background:var(--slate);} .bcard.c3 .top{background:var(--sage);}
  .bcard .bd{padding:24px;display:flex;flex-direction:column;gap:10px;height:100%;}
  .bcard .cat{font-family:var(--font-sans);text-transform:uppercase;letter-spacing:.12em;font-size:10.5px;font-weight:700;color:var(--pine-2);}
  .bcard h3{font-size:1.22rem;line-height:1.22;}
  .bcard p{color:var(--ink-soft);font-size:.95rem;}
  .bcard .read{margin-top:auto;color:var(--pine-2);font-weight:600;font-size:.9rem;}
  @media(max-width:820px){.blogt .cards{grid-template-columns:1fr;}}

  /* WhatsApp bubble */
  .wa{position:fixed;right:22px;bottom:22px;z-index:80;width:60px;height:60px;border-radius:999px;background:var(--wa);display:grid;place-items:center;box-shadow:0 12px 30px -8px rgba(37,211,102,.6);transition:transform .2s ease;}
  .wa:hover{transform:scale(1.08);}
  .wa::before{content:"";position:absolute;inset:0;border-radius:999px;box-shadow:0 0 0 0 rgba(37,211,102,.55);animation:war 2.4s ease-out infinite;}
  @keyframes war{0%{box-shadow:0 0 0 0 rgba(37,211,102,.5);}70%{box-shadow:0 0 0 16px rgba(37,211,102,0);}100%{box-shadow:0 0 0 0 rgba(37,211,102,0);}}
  .wa svg{width:34px;height:34px;position:relative;}

  /* Sticky mobile CTA */
  .mcta{display:none;}
  @media(max-width:760px){
    .mcta{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:70;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(10px);border-top:1px solid var(--line);}
    .mcta .btn{flex:1;justify-content:center;}
    body{padding-bottom:76px;}
    .wa{bottom:88px;right:16px;width:54px;height:54px;}
    .wa svg{width:30px;height:30px;}
  }

/* ==== Mari demo card ==== */
/* ==== hero-demo: la llamada de Mari ==== */
  .hd-wrap{max-width:500px;margin:0 auto;width:100%;
    --hd-card:#fff;--hd-card2:#FBF8EF;--hd-accent:#1D4A3E;--hd-ink:#20302B;--hd-soft:#5E6E66;--hd-line:#E4DECF;
    --hd-seg:#2E6B57;--hd-men:#B4652E;--hd-cue:#2C6E8A;--hd-his:#8A6D2C;
    --hd-serif:var(--font-serif,Georgia,serif);--hd-sans:var(--font-sans,system-ui,sans-serif);}
  @media (prefers-color-scheme:dark){.hd-wrap{--hd-card:#1B2A23;--hd-card2:#18251F;--hd-accent:#7FC6AE;--hd-ink:#EAF1EC;--hd-soft:#9DB1A7;--hd-line:#2B3D34;--hd-seg:#7FC6AE;--hd-men:#E0975E;--hd-cue:#7FB8D0;--hd-his:#D6BE7C;}}
  :root[data-theme="dark"] .hd-wrap{--hd-card:#1B2A23;--hd-card2:#18251F;--hd-accent:#7FC6AE;--hd-ink:#EAF1EC;--hd-soft:#9DB1A7;--hd-line:#2B3D34;--hd-seg:#7FC6AE;--hd-men:#E0975E;--hd-cue:#7FB8D0;--hd-his:#D6BE7C;}
  :root[data-theme="light"] .hd-wrap{--hd-card:#fff;--hd-card2:#FBF8EF;--hd-accent:#1D4A3E;--hd-ink:#20302B;--hd-soft:#5E6E66;--hd-line:#E4DECF;--hd-seg:#2E6B57;--hd-men:#B4652E;--hd-cue:#2C6E8A;--hd-his:#8A6D2C;}
  .hd-card{background:var(--hd-card);border:1px solid var(--hd-line);border-radius:20px;overflow:hidden;box-shadow:0 26px 60px -34px rgba(12,28,22,.5);}
  .hd-photo{position:relative;margin:0;height:190px;overflow:hidden;}
  .hd-photo img{width:100%;height:100%;object-fit:cover;object-position:center 22%;display:block;}
  .hd-grad{position:absolute;inset:auto 0 0 0;height:90px;background:linear-gradient(transparent,rgba(10,20,16,.6));}
  .hd-who{position:absolute;left:14px;bottom:11px;color:#fff;}
  .hd-who b{font-family:var(--hd-serif);font-size:1.3rem;font-weight:600;display:block;line-height:1.05;}
  .hd-who span{font-size:12px;opacity:.92;}
  .hd-live{position:absolute;top:12px;left:12px;display:inline-flex;align-items:center;gap:6px;background:rgba(16,26,22,.62);color:#fff;font-size:11px;font-weight:700;padding:5px 10px;border-radius:999px;}
  .hd-live i{width:7px;height:7px;border-radius:999px;background:#ff5f52;animation:hdpulse 1.7s infinite;}
  @keyframes hdpulse{0%{box-shadow:0 0 0 0 rgba(255,95,82,.55)}70%{box-shadow:0 0 0 8px rgba(255,95,82,0)}100%{box-shadow:0 0 0 0 rgba(255,95,82,0)}}
  .hd-rhead{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;padding:15px 16px 12px;border-bottom:1px solid var(--hd-line);}
  .hd-rhead h3{font-family:var(--hd-serif);font-weight:600;font-size:1.28rem;margin:0;line-height:1.1;color:var(--hd-ink);}
  .hd-rhead p{font-size:12px;color:var(--hd-soft);margin:3px 0 0;}
  .hd-hint{font-size:11px;color:var(--hd-soft);display:inline-flex;align-items:center;gap:5px;white-space:nowrap;}
  .hd-hint svg{width:13px;height:13px;}
  .hd-body{max-height:360px;overflow-y:auto;padding:6px 16px 8px;}
  .hd-sec{padding:12px 0 6px;}
  .hd-sechead{display:flex;align-items:center;gap:8px;margin-bottom:7px;}
  .hd-dot{width:9px;height:9px;border-radius:999px;flex:0 0 auto;}
  .hd-secname{font-weight:800;font-size:12.5px;}
  .hd-count{margin-left:auto;font-size:10.5px;font-weight:800;color:var(--hd-soft);background:color-mix(in srgb,var(--hd-soft) 14%,transparent);padding:2px 8px;border-radius:999px;}
  .hd-intro{font-size:12px;color:var(--hd-soft);line-height:1.4;margin:0 0 9px;}
  .hd-clip{display:flex;align-items:center;gap:11px;padding:9px 10px;border-radius:11px;border:1px solid var(--hd-line);margin-bottom:7px;cursor:pointer;background:var(--hd-card);transition:.16s;}
  .hd-clip:hover{border-color:var(--hd-accent);}
  .hd-clip.hd-playing{border-color:var(--hd-accent);background:color-mix(in srgb,var(--hd-accent) 8%,var(--hd-card));}
  .hd-cbtn{flex:0 0 auto;width:34px;height:34px;border-radius:999px;border:none;cursor:pointer;background:var(--hd-accent);color:var(--hd-card);display:grid;place-items:center;}
  .hd-cbtn svg{width:14px;height:14px;} .hd-cbtn .hd-pause{display:none;}
  .hd-clip.hd-playing .hd-cbtn .hd-play{display:none;} .hd-clip.hd-playing .hd-cbtn .hd-pause{display:block;}
  .hd-cmid{flex:1;min-width:0;}
  .hd-ctitle{font-weight:700;font-size:13px;line-height:1.2;color:var(--hd-ink);}
  .hd-cq{font-family:var(--hd-serif);font-style:italic;font-size:12px;color:var(--hd-soft);line-height:1.3;margin-top:1px;}
  .hd-prog{height:3px;border-radius:3px;background:var(--hd-line);margin-top:6px;overflow:hidden;display:none;}
  .hd-clip.hd-playing .hd-prog{display:block;} .hd-prog i{display:block;height:100%;width:0;background:var(--hd-accent);}
  .hd-s-seg .hd-dot{background:var(--hd-seg)} .hd-s-seg .hd-secname{color:var(--hd-seg)}
  .hd-s-men .hd-dot{background:var(--hd-men)} .hd-s-men .hd-secname{color:var(--hd-men)}
  .hd-s-cue .hd-dot{background:var(--hd-cue)} .hd-s-cue .hd-secname{color:var(--hd-cue)}
  .hd-s-his .hd-dot{background:var(--hd-his)} .hd-s-his .hd-secname{color:var(--hd-his)}
  .hd-foot{padding:12px 16px 15px;border-top:1px solid var(--hd-line);}
  .hd-foot button{width:100%;font-family:var(--hd-sans);font-weight:700;font-size:13.5px;cursor:pointer;border-radius:12px;padding:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:none;background:var(--hd-accent);color:var(--hd-card);}
  .hd-foot svg{width:15px;height:15px;}
  @media(max-width:880px){.hd-wrap{order:2;}}
</style>

