<script>
(function(){
  var root=document.documentElement;
  // El contenido es visible por defecto. Solo activamos las animaciones si el JS
  // arrancó bien: así, si algo falla más abajo, la página nunca queda en blanco.
  // Respaldo: si el observer no dispara, revelamos todo igual en 1,6s.
  root.classList.add('js-anim');
  setTimeout(function(){try{document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('in');});}catch(e){}},1600);
  var themeBtn=document.getElementById('themeBtn');
  if(themeBtn)themeBtn.addEventListener('click',function(){
    var c=root.getAttribute('data-theme')||'light';
    
    var n=c==='dark'?'light':'dark';root.setAttribute('data-theme',n);try{localStorage.setItem('theme',n);}catch(e){}
  });

  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Nav: sombra suave al scrollear
  var navEl=document.querySelector('header.nav');
  if(navEl){var onNavScroll=function(){navEl.classList.toggle('scrolled',(window.scrollY||window.pageYOffset||0)>8);};onNavScroll();window.addEventListener('scroll',onNavScroll,{passive:true});}

  // Scroll reveal
  if('IntersectionObserver' in window && !reduce){
    var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12,rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('in');});
  }

  // Count up on the big stats
  function animateCount(el){
    var to=parseFloat(el.getAttribute('data-to')), dec=parseInt(el.getAttribute('data-dec')||'0',10), start=null, dur=1200;
    function step(ts){ if(!start)start=ts; var p=Math.min((ts-start)/dur,1); var val=to*(1-Math.pow(1-p,3));
      el.textContent = dec>0 ? val.toFixed(dec) : Math.round(val).toLocaleString('en-US');
      if(p<1)requestAnimationFrame(step); else el.textContent = dec>0 ? to.toFixed(dec) : to.toLocaleString('en-US'); }
    requestAnimationFrame(step);
  }
  var counts=document.querySelectorAll('.count');
  if('IntersectionObserver' in window && !reduce){
    var co=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){animateCount(e.target);co.unobserve(e.target);}});},{threshold:.6});
    counts.forEach(function(el){co.observe(el);});
  } else { counts.forEach(function(el){var d=parseInt(el.getAttribute('data-dec')||'0',10);var t=parseFloat(el.getAttribute('data-to'));el.textContent=d>0?t.toFixed(d):t.toLocaleString('en-US');}); }

  // Form: send to matias@, hello@, pablo@ via FormSubmit, keep in-page confirmation
  var f=document.getElementById('demoForm'); if(!f)return;
  var ICON='<div class="okk"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg></div>';
  var IST='font-family:inherit;font-size:1rem;padding:12px 13px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);';
  var LST='display:flex;flex-direction:column;gap:6px;font-size:.82rem;font-weight:700;text-align:left;';
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var name=(f.name.value||'').trim(), phone=(f.phone.value||'').trim();
    if(!name){f.name.focus();return;} if(!phone){f.phone.focus();return;}
    if(f._honey && f._honey.value){return;}
    var safe=function(s){return String(s).replace(/[<>]/g,'');};
    var btn=f.querySelector('button[type=submit]'); if(btn){btn.disabled=true;btn.textContent='Joining...';}
    var d=new FormData();
    d.append('name',name); d.append('phone',phone);
    d.append('_subject','New Elderly early access signup'); d.append('_cc','hello@heyzawo.com,pablo@heyzawo.com');
    d.append('_template','table'); d.append('_captcha','false');
    function finalThanks(){
      f.innerHTML='<div class="demo-done">'+ICON+'<h3>All set, '+safe(name)+'.</h3><p>We will reach out at <strong>'+safe(phone)+'</strong> as we welcome our first families. Thank you for being early.</p></div>';
    }
    function step2(){
      f.innerHTML='<div class="demo-done">'+ICON+'<h3>You are on the list, '+safe(name)+'.</h3>'
        +'<p style="margin-bottom:16px;">One quick thing, so the first call feels personal. Optional.</p>'
        +'<label style="'+LST+'">Your parent\'s first name<input id="p2name" placeholder="Margaret" style="'+IST+'"></label>'
        +'<label style="'+LST+'margin-top:12px;">Topic to try<select id="p2topic" style="'+IST+'"><option>Easygoing, a warm light chat</option><option>Remembering, a life story</option><option>Learning, something new</option><option>Spiritual, scripture and gratitude</option></select></label>'
        +'<button id="p2save" class="btn btn-primary" style="margin-top:16px;width:100%;justify-content:center;">Save these details</button>'
        +'<p class="fine" style="margin-top:10px;"><a href="#" id="p2skip">Skip for now</a></p></div>';
      document.getElementById('p2save').addEventListener('click',function(){
        var pn=(document.getElementById('p2name').value||'').trim(), pt=document.getElementById('p2topic').value;
        var s=document.getElementById('p2save'); s.disabled=true; s.textContent='Saving...';
        var d2=new FormData(); d2.append('name',name); d2.append('phone',phone); d2.append('parent',pn); d2.append('topic',pt);
        d2.append('_subject','Elderly signup details'); d2.append('_cc','hello@heyzawo.com,pablo@heyzawo.com'); d2.append('_template','table'); d2.append('_captcha','false');
        fetch('https://formsubmit.co/ajax/matias@heyzawo.com',{method:'POST',body:d2,headers:{'Accept':'application/json'}}).then(finalThanks).catch(finalThanks);
      });
      document.getElementById('p2skip').addEventListener('click',function(ev){ev.preventDefault();finalThanks();});
    }
    fetch('https://formsubmit.co/ajax/matias@heyzawo.com',{method:'POST',body:d,headers:{'Accept':'application/json'}}).then(step2).catch(step2);
  });
})();
</script>
<script>
(function(){
  var clips=Array.prototype.slice.call(document.querySelectorAll('.hd-clip'));
  if(!clips.length) return;
  var cur=null;
  function clearUI(){ clips.forEach(function(c){ c.classList.remove('hd-playing'); var p=c.querySelector('.hd-prog i'); if(p)p.style.width='0'; }); }
  function stopAll(){ if(cur){ cur.a.pause(); cur.a.removeEventListener('timeupdate',cur.h); } clearUI(); cur=null; }
  function play(clip){
    var a=document.getElementById(clip.dataset.audio); if(!a) return;
    var same=cur&&cur.clip===clip&&!a.paused; stopAll(); if(same) return;
    clip.classList.add('hd-playing'); var prog=clip.querySelector('.hd-prog i');
    function h(){ var d=a.duration||0; var p=d?Math.max(0,Math.min(1,a.currentTime/d)):0; if(prog)prog.style.width=(p*100)+'%'; if(a.ended){ stopAll(); } }
    try{a.currentTime=0;}catch(_){}
    a.addEventListener('timeupdate',h); cur={a:a,h:h,clip:clip}; a.play().catch(function(){});
  }
  clips.forEach(function(c){ c.addEventListener('click', function(){ play(c); }); });
  function reportHTML(){
    var summary='Mari was talkative and in good spirits. She described an active routine (exercise, yoga, and a cooking class) and recalled stories from across her life in vivid detail. She opened up about loneliness and her family. She noticed herself that her memory sometimes fails her, though the rest of the chat showed her long term memory intact. She slept well, except for one night.';
    var glance=[['Mood','warm and positive'],['Memory','sharp, one signal to watch'],['Sleep','good, one rough night'],['Activity','high'],['Safety','safe word OK']];
    var SEC=[
      {name:'Her safety',count:'1 signal',c:'#2E6B57',t:'#E7F1EB',icon:'<path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
       m:[['The safe word','“The keyword is sunflower, so you know you can trust me.”','Verification working in real life: Mari asks to hear it again and the AI answers with patience. Scams and finances are on the roadmap, not something it detects yet.']]},
      {name:'Her mind and mood',count:'5 moments',c:'#B4652E',t:'#F6ECE1',icon:'<path d="M12 3a6 6 0 0 0-4 10.5c.6.5 1 1.1 1 2v.5h6v-.5c0-.9.4-1.5 1-2A6 6 0 0 0 12 3z"/><path d="M9 20h6"/>',
       m:[['Her memory','“My memory is slipping.”','She names her own fear, in her own words. It is exactly the signal families dread missing between visits.'],
          ['Recounting the novel','She recalled the entire plot of a World War II book, in detail.','Long term memory intact. It balances the point above: the chat captures both decline and strength at once.'],
          ['The same book, two days','She told the same story, the same way, two days apart.','Only daily calls build this kind of cognitive baseline.'],
          ['Alone, but not lonely','“I thought that when my husband passed I would stop existing for them, but he still visits me.”','A widow names the fear of loneliness, and her relief. Emotionally, the strongest moment of the day.'],
          ['Her grandson','“Grandma, I’m going to miss you so much.”','A living family bond, told with tenderness.']]},
      {name:'Her body and routine',count:'3 signals',c:'#2C6E8A',t:'#E6F0F4',icon:'<path d="M12 21C7 17.5 4 14 4 9.5A4.5 4.5 0 0 1 12 6a4.5 4.5 0 0 1 8 3.5C20 14 17 17.5 12 21z"/>',
       m:[['Exercise, yoga and cooking','“I do exercise, I go to yoga.” A friend carries her grocery bags.','Physical activity and a social life. The help with the bags is a subtle mobility signal, inside a warm moment.'],
          ['Reads and sleeps well','“I lie down, read a little, and sleep well.”','A healthy sleep routine, on the positive side.'],
          ['A rough night','“Not great, I don’t know why.”','A rough night, caught the same day. Together with the note above it shows the routine is tracked over time, not a single snapshot.']]},
      {name:'Stories of the week',count:'3 stories',c:'#8A6D2C',t:'#F3EDDB',icon:'<path d="M4 5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M9 8h5M9 12h6M9 16h4"/>',
       m:[['The glue stick','She searched the whole house for an hour, and it was stuck on her the whole time. “I was wearing it!”','The kind of moment you forward to the family group chat.'],
          ['The grandkids’ doodles','They drew on her face while she napped: “they had written all over my face!”','A family anecdote told with energy, very shareable.'],
          ['The thank you letters','“I should make a book with all those little letters.”','Legacy in her own voice: the stories exist, and she wants to keep them herself.']]}
    ];
    var css='*{box-sizing:border-box}body{margin:0;background:#EFE9DA;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:#20302B}.page{max-width:720px;margin:0 auto 48px}.hero{background:linear-gradient(135deg,#1D4A3E,#2E6B57);color:#F1ECDE;padding:44px 40px 42px;border-radius:0 0 28px 28px}.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:16px;letter-spacing:.02em;margin-bottom:24px}.brand .m{width:27px;height:27px;border-radius:999px;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:12px}.hero h1{font-family:Georgia,"Times New Roman",serif;font-weight:600;font-size:35px;margin:0 0 9px;letter-spacing:-.01em}.hero p{margin:0;font-size:15px;color:#D8E2D8;max-width:46ch;line-height:1.5}.body{padding:22px 24px 0}.summary{background:#fff;border:1px solid #E7E0D0;border-radius:14px;padding:15px 17px;margin:0 0 14px;font-size:14px;line-height:1.55;color:#33443C}.glance{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 20px}.gchip{background:#fff;border:1px solid #E7E0D0;border-radius:11px;padding:8px 12px}.gchip b{display:block;color:#1D4A3E;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px}.gchip span{color:#5B6B63;font-size:12.5px}.block{background:#fff;border:1px solid #E7E0D0;border-radius:18px;padding:22px 22px 12px;margin-bottom:16px;box-shadow:0 22px 46px -34px rgba(12,28,22,.55)}.bhead{display:flex;align-items:center;gap:12px;margin-bottom:6px}.bico{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;flex:0 0 auto}.bico svg{width:21px;height:21px}.bhead h2{font-family:Georgia,serif;font-weight:600;font-size:19px;margin:0;flex:1;color:#20302B}.count{font-weight:800;font-size:10.5px;letter-spacing:.03em;text-transform:uppercase;padding:5px 11px;border-radius:999px;white-space:nowrap}.moment{padding:14px 0;border-top:1px dashed #EDE6D6}.moment:first-of-type{border-top:none;padding-top:6px}.mt{font-weight:800;font-size:14px;margin:0 0 5px}.mq{font-family:Georgia,serif;font-style:italic;font-size:14.5px;line-height:1.5;color:#3A4B43;margin:0;padding-left:15px;border-left:3px solid #ccc}.mnote{font-size:12.5px;color:#6B7A72;line-height:1.45;margin:7px 0 0;padding-left:15px}footer{color:#7C8A80;font-size:12px;line-height:1.6;margin:26px 24px 0;text-align:center}footer .fl{font-weight:800;color:#2E6B57;font-size:16px;margin:0 0 6px}footer .cl{max-width:52ch;margin:0 auto 10px}@media(max-width:560px){.hero{padding:34px 22px}.hero h1{font-size:28px}.body{padding:18px 14px 0}}';
    var h='<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Elderly report · Mari</title><style>'+css+'</style></head><body><div class="page">';
    h+='<header class="hero"><div class="brand"><span class="m">≡</span> Elderly</div><h1>How Mom’s doing</h1><p>A summary of today’s chat with Mari, told in her own words.</p></header><div class="body">';
    h+='<div class="summary">'+summary+'</div><div class="glance">';
    glance.forEach(function(g){ h+='<div class="gchip"><b>'+g[0]+'</b><span>'+g[1]+'</span></div>'; });
    h+='</div>';
    SEC.forEach(function(s){ h+='<div class="block"><div class="bhead"><span class="bico" style="background:'+s.t+';color:'+s.c+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">'+s.icon+'</svg></span><h2>'+s.name+'</h2><span class="count" style="background:'+s.t+';color:'+s.c+'">'+s.count+'</span></div>';
      s.m.forEach(function(x){ h+='<div class="moment"><p class="mt">'+x[0]+'</p><p class="mq" style="border-color:'+s.c+'">'+x[1]+'</p>'+(x[2]?'<p class="mnote">'+x[2]+'</p>':'')+'</div>'; });
      h+='</div>'; });
    h+='</div><footer><p class="fl">Elderly</p><p class="cl">This report gathers what Elderly noticed during a chat with Mari. It is not a medical consultation or a diagnosis. It shares signals so the family can stay close.</p><p>callelderly.com</p></footer></div></body></html>';
    return h;
  }
  var dl=document.getElementById('hddl');
  if(dl) dl.addEventListener('click', function(){
    var blob=new Blob([reportHTML()],{type:'text/html;charset=utf-8'}); var url=URL.createObjectURL(blob);
    var a=document.createElement('a'); a.href=url; a.download='elderly-report-mari.html'; document.body.appendChild(a); a.click();
    setTimeout(function(){ URL.revokeObjectURL(url); a.remove(); },500);
  });
})();
</script>
